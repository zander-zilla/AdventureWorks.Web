 "architecture_delta": [
  {
   "area": "Front end",
   "before": "Razor MVC pages",
   "after": "React 19 + Vite + Tailwind SPA under /app/ (same origin)"
  },
  {
   "area": "API",
   "before": "MVC controllers only",
   "after": "/api/v2 minimal APIs + OpenAPI"
  },
  {
   "area": "Design",
   "before": "Bootstrap theme",
   "after": "One token set, two themes (B · Ops console dark, A · Trail light)"
  },
  {
   "area": "Showcase",
   "before": "8-tab vanilla JS site",
   "after": "Two chapters: Chapter 1 frozen at /c1/, Chapter 2 live at /"
  },
  {
   "area": "Data model",
   "before": "7 DynamoDB tables, 70 access patterns",
   "after": "Unchanged; Chapter 2 lights up designed-but-unused patterns"
  },
  {
   "area": "Site root",
   "before": "/ = Razor shop",
   "after": "/ = React shop (/app/); Razor stays at /Shop and /classic"
  },
  {
   "area": "Writes",
   "before": "Cart and checkout only",
   "after": "Fulfilment transactions (order + stock + TransactionHistory) with an app change feed; Redshift picks them up via zero-ETL"
  },
  {
   "area": "API client",
   "before": "Hand-written fetch",
   "after": "Generated from OpenAPI (openapi-typescript + openapi-fetch), checked in CI"
  }
 ],
