@model CustomerView
@{ ViewData["Title"] = "Edit customer"; }
<h1>Edit @Model.DisplayName</h1>
<form method="post">
    <label>Title <input name="title" value="@Model.Title" /></label>
    <label>First name <input name="firstName" value="@Model.FirstName" /></label>
    <label>Middle name <input name="middleName" value="@Model.MiddleName" /></label>
    <label>Last name <input name="lastName" value="@Model.LastName" /></label>
    <p><button type="submit">Save</button></p>
</form>
