@model CustomerPage
@{ ViewData["Title"] = "Customers"; }
<h1>Customers</h1>
<p><a asp-action="Create">Create new</a> <span class="muted">· sorted by last name (GSI2, CUS-05)</span></p>
<table>
<tr><th>Name</th><th>Account</th><th>Store</th><th>Territory</th><th></th></tr>
@foreach (var c in Model.Items)
{
    <tr><td>@c.DisplayName</td><td>@c.AccountNumber</td><td>@c.StoreName</td><td>@c.TerritoryName</td>
        <td><a asp-action="Edit" asp-route-id="@c.CustomerId">Edit</a> | <a asp-action="Details" asp-route-id="@c.CustomerId">Details</a></td></tr>
}
</table>
@if (Model.Next is { } n) { <p><a asp-action="Index" asp-route-page="@n">Next page</a></p> }
