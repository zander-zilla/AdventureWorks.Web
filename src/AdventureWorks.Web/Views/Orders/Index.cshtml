@model OrderPage
@{ ViewData["Title"] = "My orders"; }
<h1>My orders</h1>
<table data-testid="orders">
<tr><th>Order</th><th>Date</th><th>Status</th><th class="num">Total</th><th>Source</th></tr>
@foreach (var o in Model.Items)
{
    <tr data-testid="order-row"><td><a asp-action="Details" asp-route-id="@o.Id" data-testid="order-link">@o.Number</a></td><td>@o.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
        <td>@Order.StatusName(o.Status)</td><td class="num">@o.TotalDue.ToString("C")</td><td>@(o.Source == "ddb" ? "DynamoDB (this app)" : "SQL (before app, via CDC)")</td></tr>
}
</table>
@if (Model.Next is { } n) { <p><a asp-action="Index" asp-route-page="@n">Older orders</a></p> }
