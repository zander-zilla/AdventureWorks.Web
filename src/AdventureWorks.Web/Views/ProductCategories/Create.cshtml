@{ ViewData["Title"] = "Create category"; var tree = (List<Category>)ViewData["Tree"]!; }
<h1>Create category or subcategory</h1>
<form method="post">
    <div asp-validation-summary="All" class="err"></div>
    <label>Name <input name="name" /></label>
    <label>Parent category (empty = top-level category) <select name="parentId"><option value="">(none)</option>@foreach (var c in tree) { <option value="@c.Id">@c.Name</option> }</select></label>
    <p><button type="submit">Create</button></p>
</form>
