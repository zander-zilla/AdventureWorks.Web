@model Category
@{ var sub = ViewData["Sub"] as Subcategory; var tree = (List<Category>)ViewData["Tree"]!; ViewData["Title"] = "Edit"; }
<h1>Edit @(sub?.Name ?? Model.Name)</h1>
<form method="post">
    <input type="hidden" name="sub" value="@sub?.Id" />
    <label>Name <input name="name" value="@(sub?.Name ?? Model.Name)" /></label>
    @if (sub is not null)
    {
        <label>Category <select name="parentId">@foreach (var c in tree) { <option value="@c.Id" selected="@(c.Id == Model.Id)">@c.Name</option> }</select></label>
    }
    <p><button type="submit">Save</button></p>
</form>
