@model ProductPage
@{ ViewData["Title"] = "Products"; }
<h1>Products</h1>
<p><a asp-action="Create">Create new</a> · <form method="get" class="inline"><input name="q" value="@ViewData["q"]" placeholder="name starts with" /> <button>Filter</button></form></p>
<table>
<tr><th>Name</th><th>Number</th><th class="num">List price</th><th>Status</th><th></th></tr>
@foreach (var p in Model.Items)
{
    <tr><td>@p.Name</td><td>@p.ProductNumber</td><td class="num">@p.ListPrice.ToString("C")</td><td>@(p.Active ? "Active" : "Inactive")</td>
        <td><a asp-action="Edit" asp-route-id="@p.Id">Edit</a> | <a asp-action="Details" asp-route-id="@p.Id">Details</a> | <a asp-action="Delete" asp-route-id="@p.Id">Delete</a></td></tr>
}
</table>
@if (Model.Next is { } n) { <p><a asp-action="Index" asp-route-page="@n">Next page</a></p> }
