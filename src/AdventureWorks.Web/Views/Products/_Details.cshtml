@model Product
<table>
<tr><th>Number</th><td>@Model.ProductNumber</td></tr>
<tr><th>Category / subcategory</th><td>@Model.CategoryName / @Model.SubcategoryName</td></tr>
<tr><th>Model</th><td>@Model.ModelName</td></tr>
<tr><th>Color / size / weight</th><td>@Model.Color @Model.Size @Model.Weight</td></tr>
<tr><th>List price / cost</th><td>@Model.ListPrice.ToString("C") / @Model.StandardCost.ToString("C")</td></tr>
<tr><th>Sell start / end</th><td>@Model.SellStartDate?.ToString("yyyy-MM-dd") / @Model.SellEndDate?.ToString("yyyy-MM-dd")</td></tr>
<tr><th>Stock (copy from aw-inventory)</th><td>@Model.StockQty</td></tr>
<tr><th>Status</th><td>@(Model.Active ? "Active" : "Inactive")</td></tr>
<tr><th>Source / version</th><td>@Model.Source / @Model.Version</td></tr>
</table>
