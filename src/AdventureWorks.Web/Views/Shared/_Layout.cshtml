<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdventureWorks (after)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav>
        <a class="brand" href="/Shop">AdventureWorks <small>.NET 10 + DynamoDB</small></a>
        <a asp-controller="Shop" asp-action="Index">Shop</a>
        <a href="/app/" data-testid="nav-new-ui">New UI</a>
        <a asp-controller="Products" asp-action="Index">Products</a>
        <a asp-controller="ProductCategories" asp-action="Index">Categories</a>
        <a asp-controller="Customers" asp-action="Index">Customers</a>
        <a asp-controller="Home" asp-action="About">About</a>
        <form class="search" asp-controller="Shop" asp-action="Search" method="get">
            <input name="q" placeholder="Search products (name starts with...)" data-testid="search-box" value="@Context.Request.Query["q"]" />
            <button type="submit" data-testid="search-go">Search</button>
        </form>
        <span class="right">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Cart" asp-action="Index" data-testid="nav-cart">Cart</a>
            <a asp-controller="Orders" asp-action="Index" data-testid="nav-orders">My orders</a>
            <span data-testid="user-name">@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline"><button type="submit" class="link">Log out</button></form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" data-testid="nav-login">Demo login</a>
        }
        </span>
    </nav>
</header>
<main>
    @if (TempData["Message"] is string m) { <p class="msg" data-testid="flash">@m</p> }
    @if (TempData["Error"] is string e) { <p class="err" data-testid="flash-error">@e</p> }
    @RenderBody()
</main>
<footer>AFTER: ASP.NET Core (.NET 10) on DynamoDB single-table designs (aw-catalog, aw-customer, aw-sales). Orders placed here are DynamoDB-native (SO-DDB-…) and reach Redshift via zero-ETL.</footer>
</body>
</html>
