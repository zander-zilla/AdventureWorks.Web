@model List<Category>
@{ ViewData["Title"] = "Shop"; }
<h1>Shop by category</h1>
<div class="cards">
@foreach (var c in Model)
{
    <div class="card" data-testid="category">
        <h3>@c.Name</h3>
        <ul>@foreach (var s in c.Subcategories) { <li><a asp-action="Subcategory" asp-route-id="@s.Id" data-testid="subcategory-link">@s.Name</a></li> }</ul>
    </div>
}
</div>
