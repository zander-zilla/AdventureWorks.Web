@model Product
@{ ViewData["Title"] = Model.Name; var culture = (string)ViewData["Culture"]!; var descs = (List<ModelDescription>)ViewData["Descriptions"]!;
   var d = descs.FirstOrDefault(x => x.Culture == culture) ?? descs.FirstOrDefault(x => x.Culture == "en");
   var rtl = culture is "ar" or "he"; }
<p><a asp-action="Index">Shop</a> / @Model.CategoryName / @if (Model.SubcategoryId is { } s) { <a asp-action="Subcategory" asp-route-id="@s">@Model.SubcategoryName</a> }</p>
<h1 data-testid="product-name">@Model.Name</h1>
<p>@Model.ProductNumber · @Model.Color @Model.Size · Model: @Model.ModelName</p>
<p><strong data-testid="product-price">@Model.ListPrice.ToString("C")</strong> · in stock: @Model.StockQty</p>
<p>Description language:
@foreach (var c in AdventureWorks.Web.Data.CatalogRepository.Cultures)
{
    if (c == culture) { <strong>@c</strong> } else { <a asp-route-id="@Model.Id" asp-route-culture="@c" data-testid="culture-@c">@c</a> }
    <text> </text>
}
</p>
<blockquote data-testid="product-description" dir="@(rtl ? "rtl" : "ltr")" lang="@culture">@(d?.Text ?? "No description.")</blockquote>
@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Cart" asp-action="Add" method="post">
        <input type="hidden" name="productId" value="@Model.Id" />
        <label>Quantity <input type="number" name="quantity" value="1" min="1" max="99" /></label>
        <button type="submit" data-testid="add-to-cart">Add to cart</button>
    </form>
}
else { <p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in</a> to add to cart (carts are for logged-in customers, D3).</p> }
