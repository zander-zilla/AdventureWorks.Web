@model List<Product>
@{ var sub = (Subcategory)ViewData["Sub"]!; ViewData["Title"] = sub.Name; var sort = Context.Request.Query["sort"].ToString();
   var rows = sort == "price" ? Model.OrderBy(p => p.ListPrice).ToList() : Model; }
<p><a asp-action="Index">Shop</a> / @sub.CategoryName</p>
<h1>@sub.Name</h1>
<p>Sort: <a href="?sort=name">name</a> | <a href="?sort=price">price</a> <span class="muted">(price sort client-side, CAT-03)</span></p>
<table>
<tr><th>Product</th><th>Number</th><th>Color</th><th>Size</th><th class="num">Price</th></tr>
@foreach (var p in rows)
{
    <tr><td><a asp-action="Product" asp-route-id="@p.Id" data-testid="product-link">@p.Name</a></td><td>@p.ProductNumber</td><td>@p.Color</td><td>@p.Size</td><td class="num">@p.ListPrice.ToString("C")</td></tr>
}
</table>
