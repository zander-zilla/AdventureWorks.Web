  "components": {
    "schemas": {
      "BackOfficeOrder": {
        "required": [
          "order",
          "statusText",
          "actions",
          "stock"
        ],
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "statusText": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stock": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineStock"
            }
          }
        }
      },
      "BulkItem": {
        "required": [
          "id",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BulkRequest": {
        "required": [
          "orders"
        ],
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkItem"
            }
          }
        }
      },
      "BulkResult": {
        "required": [
          "id",
          "ok",
          "message"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CartItemRequest": {
        "required": [
          "productId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CartLine": {
        "required": [
          "productId",
          "name",
          "productNumber",
          "unitPrice",
          "quantity",
          "added"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "productNumber": {
            "type": "string"
          },
          "unitPrice": {
            "type": "number",
            "format": "double"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "added": {
            "type": "string",
            "format": "date-time"
          },
          "lineTotal": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Category": {
        "required": [
          "id",
          "name",
          "subcategories"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "subcategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subcategory"
            }
          }
        }
      },
      "CheckoutRequest": {
        "required": [
          "shipMethodId"
        ],
        "type": "object",
        "properties": {
          "shipMethodId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "FeedEntry": {
        "required": [
          "id",
          "at",
          "event",
          "subject",
          "actor",
          "writes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string",
